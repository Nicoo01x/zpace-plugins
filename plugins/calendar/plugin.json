{
  "id": "calendar",
  "name": "Calendar",
  "version": "1.0.0",
  "description": "A month view with your events, reminders in the island ten minutes before, and a note for any event in one click — kept on this machine, no account.",
  "author": { "name": "Nicolás Cabanillas", "github": "Nicoo01x" },
  "icon": "icon.svg",
  "tags": ["script", "pane", "command"],
  "permissions": ["commands", "notifications", "panes", "events", "notes"],
  "contributes": {
    "commands": [
      { "id": "open", "title": "Calendar: open", "keywords": ["calendar", "calendario", "events", "agenda"], "action": { "kind": "pane", "pane": "calendar" } }
    ],
    "panes": [{ "id": "calendar", "title": "Calendar", "entry": "pane.html" }]
  },
  "main": "main.js"
}
