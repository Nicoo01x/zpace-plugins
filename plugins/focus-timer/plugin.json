{
  "id": "focus-timer",
  "name": "Focus Timer",
  "version": "1.1.0",
  "description": "A focus timer that lives in the island: the countdown next to the Zpace mark, a click for pause / resume / reset, any length you want, and the pane keeps your blocks for the day.",
  "author": {
    "name": "Nicolás Cabanillas",
    "github": "Nicoo01x"
  },
  "icon": "icon.svg",
  "tags": [
    "script",
    "pane",
    "command"
  ],
  "permissions": [
    "commands",
    "notifications",
    "panes",
    "events"
  ],
  "contributes": {
    "commands": [
      {
        "id": "open",
        "title": "Focus: open the timer",
        "keywords": [
          "pomodoro",
          "timer",
          "focus",
          "temporizador"
        ],
        "action": {
          "kind": "pane",
          "pane": "timer"
        }
      }
    ],
    "panes": [
      {
        "id": "timer",
        "title": "Focus",
        "entry": "pane.html"
      }
    ]
  },
  "main": "main.js"
}
